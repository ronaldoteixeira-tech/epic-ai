      "id": "1c63acf5-6635-4020-86e7-d75575d80f31",
      "name": "Webhook — Consultar agenda",
      "webhookId": "695f5762-f415-47d2-b946-0609b560e60d"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body ?? $input.first().json;\nconst duration = [30,45].includes(Number(body.duration)) ? Number(body.duration) : 30;\nconst days = Math.max(1, Math.min(31, Number(body.days) || 21));\nconst now = new Date();\nconst timeMin = new Date(now.getTime() + 24*60*60*1000);\nconst timeMax = new Date(now.getTime() + days*24*60*60*1000);\nreturn [{json:{lead_id:body.lead_id,duration,days,timezone:'America/Sao_Paulo',timeMin:timeMin.toISOString(),timeMax:timeMax.toISOString()}}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-800, -300],
      "id": "93610c0e-cbc5-47c4-8749-bdc1fbf594f1",
      "name": "Preparar janela"
    },
    {
      "parameters": {
        "resource": "calendar",
        "operation": "availability",
        "calendar": { "__rl": true, "value": "REPLACE_WITH_CALENDAR_ID", "mode": "id" },
        "timeMin": "={{ $json.timeMin }}",
        "timeMax": "={{ $json.timeMax }}",
        "options": {
          "outputFormat": "bookedSlots",
          "timezone": { "__rl": true, "value": "America/Sao_Paulo", "mode": "id" }
        }
      },
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [-560, -300],
      "id": "5ae4c566-85ee-4369-a2a9-0e81cb3394b1",
      "name": "Google Calendar — Horários ocupados",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const request = $('Preparar janela').first().json;\nconst busy = $input.all().map(i => i.json).filter(i => i.start && i.end).map(i => ({start:new Date(i.start).getTime(),end:new Date(i.end).getTime()}));\nconst fmt = new Intl.DateTimeFormat('en-CA',{timeZone:'America/Sao_Paulo',year:'numeric',month:'2-digit',day:'2-digit'});\nconst key = d => { const p=Object.fromEntries(fmt.formatToParts(d).map(x=>[x.type,x.value])); return `${p.year}-${p.month}-${p.day}`; };\nconst pad = n => String(n).padStart(2,'0');\nconst slots=[];\nconst now=Date.now();\nfor(let offset=1;offset<=request.days;offset++){\n  const probe=new Date(now+offset*86400000);\n  const date=key(probe);\n  const noon=new Date(`${date}T12:00:00-03:00`);\n  const weekday=noon.getUTCDay();\n  if(weekday===0||weekday===6) continue;\n  for(let minute=9*60;minute+request.duration<=18*60;minute+=30){\n    const hh=pad(Math.floor(minute/60)), mm=pad(minute%60);\n    const start=new Date(`${date}T${hh}:${mm}:00-03:00`);\n    const end=new Date(start.getTime()+request.duration*60000);\n    if(start.getTime()<now+24*60*60*1000) continue;\n    if(busy.some(b=>start.getTime()<b.end && end.getTime()>b.start)) continue;\n    slots.push({start:start.toISOString(),end:end.toISOString()});\n  }\n}\nreturn [{json:{ok:true,timezone:'America/Sao_Paulo',duration:request.duration,slots:slots.slice(0,80)}}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-320, -300],
      "id": "817103f3-e540-4d07-a4ed-f9e66ca29230",
