    {
      "parameters": {
        "jsCode": "const lead=$input.first().json;\nconst request=$('Webhook — Agendar').first().json.body;\nif(!lead.lead_id) throw new Error('Lead não encontrado');\nif(lead.route_key==='nutrition'||Number(lead.epic_score)<40) throw new Error('Lead não elegível para agenda');\nconst duration=Number(lead.calendar_duration);\nif(![30,45].includes(duration)) throw new Error('Duração de agenda inválida');\nconst start=new Date(request.start);\nif(Number.isNaN(start.getTime())||start.getTime()<Date.now()+60*60*1000) throw new Error('Horário inválido');\nconst end=new Date(start.getTime()+duration*60000);\nreturn [{json:{...lead,start:start.toISOString(),end:end.toISOString(),calendar_duration:duration}}];"
      },
